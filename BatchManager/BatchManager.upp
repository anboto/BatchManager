description "For running multiple processes under memory and hardware constraints\377";

uses
	CtrlLib,
	SysInfo,
	Controls4U,
	ScatterCtrl;

options(CLANG & PEDANTIC) "-Wall -Wextra -Wunused-parameter -Wlogical-op-parentheses -Wdeprecated-copy-with-user-provided-copy -Woverloaded-virtual -Wmissing-braces -Wshadow -Wimplicit-fallthrough -Wsign-conversion -Wformat=2";

file
	main.cpp,
	main.h,
	Batch.cpp,
	Auxiliar.cpp,
	BatchManager.lay,
	main.rc,
	main.iml,
	help.tpp,
	BatchManager.t,
	Copying;

mainconfig
	"" = "GUI",
	"" = "GUI PEDANTIC";

